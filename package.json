{
  "name": "metrion-public",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Metrion contracts and public agent clients",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xMetrion/Metrion.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
